blueprint:
  name: Smarter Lüftungsassistent Plus v2
  description: >
    Lüftungsassistent pro Raum. Priorisiert im Sommer/bei Hitze das Abkühlen,
    warnt schnell bei heißer Außenluft und nutzt Feuchtigkeit nur dann als
    Schließgrund, wenn keine starke Abkühlung aktiv ist.
  domain: automation

  input:
    room_name:
      name: Raumname
      selector:
        text:

    window_sensor:
      name: Fensterkontakt
      selector:
        entity:
          domain: binary_sensor

    indoor_temperature:
      name: Raumtemperatur
      selector:
        entity:
          domain: sensor
          device_class: temperature

    indoor_humidity:
      name: Raum-Luftfeuchtigkeit
      selector:
        entity:
          domain: sensor
          device_class: humidity

    outdoor_temperature:
      name: Außentemperatur
      selector:
        entity:
          domain: sensor
          device_class: temperature

    outdoor_humidity:
      name: Außen-Luftfeuchtigkeit
      selector:
        entity:
          domain: sensor
          device_class: humidity

    notify_service:
      name: Notify-Service
      default: notify.pushover
      selector:
        text:

    target_humidity:
      name: Ziel-Luftfeuchte
      default: 55
      selector:
        number:
          min: 35
          max: 70
          step: 1
          unit_of_measurement: "%"

    min_humidity_drop:
      name: Mindest-Feuchteabfall
      default: 5
      selector:
        number:
          min: 1
          max: 20
          step: 1
          unit_of_measurement: "%"

    cooling_target_margin:
      name: Abkühlen bis Innen nur noch X °C wärmer als Außen
      default: 0.5
      selector:
        number:
          min: 0
          max: 5
          step: 0.1
          unit_of_measurement: "°C"

    cooling_active_margin:
      name: Abkühlen aktiv, wenn Außen mindestens X °C kühler ist
      default: 2
      selector:
        number:
          min: 0.5
          max: 10
          step: 0.5
          unit_of_measurement: "°C"

    hot_outside_margin:
      name: Draußen deutlich heißer ab
      default: 2
      selector:
        number:
          min: 0.5
          max: 10
          step: 0.5
          unit_of_measurement: "°C"

    early_hot_warning_minutes:
      name: Frühe Hitzewarnung nach
      default: 2
      selector:
        number:
          min: 1
          max: 10
          step: 1
          unit_of_measurement: "min"

    normal_check_after_minutes:
      name: Normale Prüfung frühestens nach
      default: 5
      selector:
        number:
          min: 1
          max: 30
          step: 1
          unit_of_measurement: "min"

    check_interval_minutes:
      name: Prüfintervall
      default: 2
      selector:
        number:
          min: 1
          max: 15
          step: 1
          unit_of_measurement: "min"

    max_open_time_minutes:
      name: Maximale Lüftungsdauer
      default: 60
      selector:
        number:
          min: 10
          max: 240
          step: 5
          unit_of_measurement: "min"

mode: restart

trigger:
  - platform: state
    entity_id: !input window_sensor
    to: "on"

variables:
  room_name: !input room_name
  window_sensor: !input window_sensor
  indoor_temperature: !input indoor_temperature
  indoor_humidity: !input indoor_humidity
  outdoor_temperature: !input outdoor_temperature
  outdoor_humidity: !input outdoor_humidity
  notify_service: !input notify_service
  target_humidity: !input target_humidity
  min_humidity_drop: !input min_humidity_drop
  cooling_target_margin: !input cooling_target_margin
  cooling_active_margin: !input cooling_active_margin
  hot_outside_margin: !input hot_outside_margin
  early_hot_warning_minutes: !input early_hot_warning_minutes
  normal_check_after_minutes: !input normal_check_after_minutes
  check_interval_minutes: !input check_interval_minutes
  max_open_time_minutes: !input max_open_time_minutes
  start_humidity: "{{ states(indoor_humidity) | float(0) }}"
  start_temperature: "{{ states(indoor_temperature) | float(0) }}"
  start_time: "{{ now() }}"

action:
  - repeat:
      while:
        - condition: state
          entity_id: !input window_sensor
          state: "on"
      sequence:
        - variables:
            ti: "{{ states(indoor_temperature) | float(0) }}"
            hi: "{{ states(indoor_humidity) | float(0) }}"
            ta: "{{ states(outdoor_temperature) | float(0) }}"
            ha: "{{ states(outdoor_humidity) | float(0) }}"

            open_minutes: >
              {{ ((as_timestamp(now()) - as_timestamp(start_time)) / 60) | round(1) }}

            abs_in: >
              {{ (216.7 * ((hi / 100) * 6.112 * (2.718281828 ** ((17.62 * ti) / (243.12 + ti)))) / (273.15 + ti)) | round(2) }}

            abs_out: >
              {{ (216.7 * ((ha / 100) * 6.112 * (2.718281828 ** ((17.62 * ta) / (243.12 + ta)))) / (273.15 + ta)) | round(2) }}

            humidity_drop: "{{ (start_humidity - hi) | round(1) }}"
            temperature_drop: "{{ (start_temperature - ti) | round(1) }}"

            strong_cooling_active: >
              {{ ta <= ti - cooling_active_margin }}

            cooling_done: >
              {{ ta < ti and ti <= ta + cooling_target_margin }}

            humidity_done: >
              {{ hi <= target_humidity or humidity_drop >= min_humidity_drop }}

            humidity_done_allowed: >
              {{ humidity_done and not strong_cooling_active }}

            outside_hot_warning: >
              {{ open_minutes >= early_hot_warning_minutes and ta >= ti + hot_outside_margin }}

            outside_not_drier: >
              {{ abs_out >= abs_in }}

            ventilation_counterproductive: >
              {{ ta > ti and outside_not_drier }}

            normal_checks_allowed: >
              {{ open_minutes >= normal_check_after_minutes }}

            max_time_reached: >
              {{ open_minutes >= max_open_time_minutes }}

            should_notify: >
              {{
                outside_hot_warning
                or max_time_reached
                or (
                  normal_checks_allowed and (
                    cooling_done
                    or humidity_done_allowed
                    or ventilation_counterproductive
                  )
                )
              }}

            notify_reason: >
              {% if outside_hot_warning %}
                Draußen ist es deutlich heißer als drinnen. Fenster besser schließen, damit keine Hitze hereinkommt.
              {% elif cooling_done %}
                Der Raum ist fast auf Außentemperatur abgekühlt.
              {% elif humidity_done_allowed %}
                Die Luftfeuchtigkeit wurde ausreichend reduziert.
              {% elif ventilation_counterproductive %}
                Lüften wird kontraproduktiv: draußen ist es wärmer und nicht trockener als drinnen.
              {% elif max_time_reached %}
                Die maximale Lüftungsdauer wurde erreicht.
              {% else %}
                Lüften ist noch sinnvoll.
              {% endif %}

        - choose:
            - conditions:
                - condition: template
                  value_template: "{{ should_notify }}"
              sequence:
                - action: "{{ notify_service }}"
                  data:
                    title: "Fenster schließen"
                    message: >
                      {{ room_name }}: {{ notify_reason }}

                      Fenster offen seit ca. {{ open_minutes }} Minuten.

                      Innen: {{ ti }} °C / {{ hi }} %
                      Außen: {{ ta }} °C / {{ ha }} %

                      Temperaturänderung seit Öffnen: {{ temperature_drop }} °C
                      Feuchteänderung seit Öffnen: {{ humidity_drop }} %

                      Absolute Feuchte innen/außen:
                      {{ abs_in }} / {{ abs_out }} g/m³
                    data:
                      priority: 0
                - stop: "Benachrichtigung gesendet"

        - delay:
            minutes: !input check_interval_minutes
