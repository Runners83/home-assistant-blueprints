blueprint:
  name: Basis Rollo Fenster Nacht ohne Morgen-Auto
  description: >
    Fenster auf fährt Rollo hoch. Beim Schließen wird je nach Dunkelheit,
    Morgenfreigabe oder vorherigem Zustand entschieden. Abends kann automatisch
    geschlossen werden. Morgens wird NICHT automatisch geöffnet.
  domain: automation

  input:
    master_switch:
      name: Master-Schalter Automatik
      selector:
        entity:
          domain: input_boolean

    cover_entity:
      name: Rollo
      selector:
        entity:
          domain: cover

    window_contact:
      name: Fensterkontakt
      selector:
        entity:
          domain: binary_sensor

    light_sensor:
      name: Lichtsensor
      selector:
        entity:
          domain: sensor

    evening_close_mode:
      name: Abend-Schließen
      default: light
      selector:
        select:
          options:
            - label: Aus
              value: "off"
            - label: Nach Helligkeit
              value: "light"
            - label: Nach Uhrzeit
              value: "time"
            - label: Helligkeit oder Uhrzeit
              value: "both"

    evening_light_threshold:
      name: Abend schließen unter Lux
      default: 5
      selector:
        number:
          min: 0
          max: 100000
          step: 1

    evening_close_time:
      name: Abend-Schließzeit
      default: "22:00:00"
      selector:
        time: {}

    morning_time:
      name: Morgenfreigabe ab Uhrzeit
      description: Nur für Entscheidung beim Fensterschließen. Fährt NICHT automatisch hoch.
      default: "07:00:00"
      selector:
        time: {}

    morning_light_threshold:
      name: Morgenfreigabe über Lux
      description: Nur für Entscheidung beim Fensterschließen. Fährt NICHT automatisch hoch.
      default: 20
      selector:
        number:
          min: 0
          max: 100000
          step: 1

    has_separate_sun_protection:
      name: Dieses Rollo hat separate Sonnenschutz-Automation
      description: Nur bei den Rollos aktivieren, die zusätzlich deine Sonnenschutz-Blueprint nutzen.
      default: false
      selector:
        boolean: {}

    open_position:
      name: Offen-Position
      default: 100
      selector:
        number:
          min: 0
          max: 100
          unit_of_measurement: "%"

    closed_position:
      name: Geschlossen-Position / Nachtposition
      default: 0
      selector:
        number:
          min: 0
          max: 100
          unit_of_measurement: "%"

mode: restart

trigger:
  - platform: state
    entity_id: !input window_contact
    to: "on"
    id: window_opened

  - platform: state
    entity_id: !input window_contact
    to: "off"
    id: window_closed

  - platform: numeric_state
    entity_id: !input light_sensor
    below: !input evening_light_threshold
    id: evening_dark

  - platform: time
    at: !input evening_close_time
    id: evening_time

variables:
  master_switch: !input master_switch
  cover_entity: !input cover_entity
  light_sensor: !input light_sensor

  evening_close_mode: !input evening_close_mode
  evening_light_threshold: !input evening_light_threshold

  morning_time: !input morning_time
  morning_light_threshold: !input morning_light_threshold
  has_separate_sun_protection: !input has_separate_sun_protection

  open_position: !input open_position
  closed_position: !input closed_position

  current_light: "{{ states(light_sensor) | float(999999) }}"

  is_dark: >
    {{ current_light < evening_light_threshold | float }}

  is_morning_released: >
    {{
      current_light > morning_light_threshold | float
      and now().strftime('%H:%M:%S') >= morning_time
    }}

  snapshot_scene: "rollo_snapshot_{{ this.entity_id | replace('.', '_') }}"

condition:
  - condition: template
    value_template: >
      {{ is_state(master_switch, 'on') }}

action:
  - choose:
      - conditions:
          - condition: trigger
            id: window_opened
        sequence:
          - service: scene.create
            data:
              scene_id: "{{ snapshot_scene }}"
              snapshot_entities:
                - "{{ cover_entity }}"

          - service: cover.set_cover_position
            target:
              entity_id: "{{ cover_entity }}"
            data:
              position: "{{ open_position }}"

      - conditions:
          - condition: trigger
            id: window_closed
        sequence:
          - choose:
              - conditions:
                  - condition: template
                    value_template: "{{ is_dark }}"
                sequence:
                  - service: cover.set_cover_position
                    target:
                      entity_id: "{{ cover_entity }}"
                    data:
                      position: "{{ closed_position }}"

              - conditions:
                  - condition: template
                    value_template: "{{ is_morning_released and has_separate_sun_protection }}"
                sequence:
                  - stop: "Morgenfreigabe aktiv, separate Sonnenschutz-Automation darf übernehmen"

              - conditions:
                  - condition: template
                    value_template: "{{ is_morning_released }}"
                sequence:
                  - stop: "Morgenfreigabe aktiv, Rollo bleibt oben"

            default:
              - condition: template
                value_template: >
                  {{ states('scene.' ~ snapshot_scene) not in ['unknown', 'unavailable'] }}
              - service: scene.turn_on
                target:
                  entity_id: "scene.{{ snapshot_scene }}"

      - conditions:
          - condition: trigger
            id: evening_dark
          - condition: template
            value_template: "{{ evening_close_mode in ['light', 'both'] }}"
          - condition: state
            entity_id: !input window_contact
            state: "off"
        sequence:
          - service: cover.set_cover_position
            target:
              entity_id: "{{ cover_entity }}"
            data:
              position: "{{ closed_position }}"

      - conditions:
          - condition: trigger
            id: evening_time
          - condition: template
            value_template: "{{ evening_close_mode in ['time', 'both'] }}"
          - condition: state
            entity_id: !input window_contact
            state: "off"
        sequence:
          - service: cover.set_cover_position
            target:
              entity_id: "{{ cover_entity }}"
            data:
              position: "{{ closed_position }}"
