blueprint:
  name: Intelligenter Sonnenschutz V2.0.2 – DWD, Lux, Sonnenstand, Fenster und Markise
  description: >
    Version 2.0.2. Startet die Beschattung nur bei passenden Wetter-, Bewölkungs-,
    Helligkeits-, Sonnenstands- und Temperaturbedingungen. Eine bereits erreichte
    Beschattungsposition bleibt auch bei Wolken und schwankenden Luxwerten erhalten.
    Die aktuelle Rollo-Position bestimmt das Verhalten: geschlossen = Nacht/Schlaf,
    offen = Sonnenschutz prüfen, Beschattungsposition = Automatik halten und jede
    andere Zwischenposition = manuelle Position respektieren.

    Fenster und optionale Markise öffnen das Rollo vorübergehend. Vorher wird die
    aktuelle Rollo-Position in einer dynamischen Szene gespeichert und nach dem
    Schließen des Fensters beziehungsweise Einfahren der Markise wiederhergestellt.
    Die Szene ist nur bis zum nächsten Neustart von Home Assistant verfügbar.
  domain: automation
  homeassistant:
    min_version: 2024.6.0

  input:
    master_switch:
      name: Master-Schalter Sonnenschutz
      selector:
        entity:
          filter:
            - domain: input_boolean

    local_switch:
      name: Schalter für dieses Rollo
      selector:
        entity:
          filter:
            - domain: input_boolean

    manual_boost_switch:
      name: Manueller Hitzeschutz
      selector:
        entity:
          filter:
            - domain: input_boolean

    manual_boost_off_time:
      name: Manuellen Hitzeschutz spätestens ausschalten
      default: "18:00:00"
      selector:
        time:

    automation_start_time:
      name: Beginn der Sonnenschutz-Automatik
      description: >
        Vor dieser Uhrzeit bleibt der Blueprint vollständig gesperrt. Standardmäßig
        beginnt die Automatik um 09:00 Uhr.
      default: "09:00:00"
      selector:
        time:

    shading_end_time:
      name: Ende der automatischen Beschattung / Beginn Nachtsperre
      description: >
        Zu dieser Uhrzeit wird ein Rollo aus der Beschattungsposition vollständig
        geöffnet. Danach bleibt der Blueprint bis zur Startzeit gesperrt.
        Geschlossene oder manuell gewählte Zwischenpositionen bleiben unverändert.
      default: "18:00:00"
      selector:
        time:

    cover_entity:
      name: Rollo
      selector:
        entity:
          filter:
            - domain: cover

    window_contact:
      name: Fensterkontakt
      description: "on = geöffnet, off = geschlossen"
      selector:
        entity:
          filter:
            - domain: binary_sensor

    awning:
      name: Markise (optional)
      description: Leer lassen, wenn für diesen Raum keine Markise berücksichtigt wird.
      default: []
      selector:
        entity:
          filter:
            - domain: cover

    illuminance_sensor:
      name: Helligkeitssensor
      selector:
        entity:
          filter:
            - domain: sensor
              device_class: illuminance

    weather_condition_sensor:
      name: DWD-Wetterzustand
      description: Zum Beispiel sensor.herne_wetterzustand.
      selector:
        entity:
          filter:
            - domain: sensor

    cloud_cover_sensor:
      name: DWD-Bewölkungsgrad
      description: Numerischer Wert von 0 bis 100 Prozent.
      selector:
        entity:
          filter:
            - domain: sensor

    outside_temperature_sensor:
      name: Außentemperatur
      selector:
        entity:
          filter:
            - domain: sensor
              device_class: temperature

    inside_temperature_sensor:
      name: Innentemperatur dieses Raums
      selector:
        entity:
          filter:
            - domain: sensor
              device_class: temperature

    minimum_outside_temperature:
      name: Mindest-Außentemperatur
      description: >
        Die Beschattung darf starten, wenn Außen- ODER Innentemperatur über dem
        jeweiligen Grenzwert liegt.
      default: 20
      selector:
        number:
          min: 0
          max: 40
          step: 0.5
          unit_of_measurement: "°C"

    minimum_inside_temperature:
      name: Mindest-Innentemperatur
      default: 22
      selector:
        number:
          min: 10
          max: 35
          step: 0.5
          unit_of_measurement: "°C"

    minimum_elevation:
      name: Minimale Sonnenhöhe
      default: 30
      selector:
        number:
          min: 0
          max: 80
          step: 1
          unit_of_measurement: "°"

    minimum_azimuth:
      name: Azimut – Beginn des Fensterbereichs
      default: 110
      selector:
        number:
          min: 0
          max: 359
          step: 1
          unit_of_measurement: "°"

    maximum_azimuth:
      name: Azimut – Ende des Fensterbereichs
      default: 247
      selector:
        number:
          min: 0
          max: 359
          step: 1
          unit_of_measurement: "°"

    maximum_cloud_cover:
      name: Maximal erlaubter Bewölkungsgrad
      description: Oberhalb dieses Wertes startet keine neue Beschattung.
      default: 70
      selector:
        number:
          min: 0
          max: 100
          step: 1
          unit_of_measurement: "%"

    lux_threshold_cloud_0_20:
      name: Lux-Schwelle bei 0–20 % Bewölkung
      default: 30000
      selector:
        number:
          min: 5000
          max: 100000
          step: 1000
          unit_of_measurement: lx

    lux_threshold_cloud_21_40:
      name: Lux-Schwelle bei 21–40 % Bewölkung
      default: 35000
      selector:
        number:
          min: 5000
          max: 100000
          step: 1000
          unit_of_measurement: lx

    lux_threshold_cloud_41_60:
      name: Lux-Schwelle bei 41–60 % Bewölkung
      default: 42000
      selector:
        number:
          min: 5000
          max: 100000
          step: 1000
          unit_of_measurement: lx

    lux_threshold_cloud_61_100:
      name: Lux-Schwelle bei 61–100 % Bewölkung
      description: Wirkt nur bis zum maximal erlaubten Bewölkungsgrad.
      default: 52000
      selector:
        number:
          min: 5000
          max: 120000
          step: 1000
          unit_of_measurement: lx

    allowed_weather_states:
      name: Erlaubte Wetterzustände für den Start
      default:
        - sunny
        - partlycloudy
      selector:
        select:
          multiple: true
          options:
            - label: Sonnig
              value: sunny
            - label: Teilweise bewölkt
              value: partlycloudy
            - label: Bewölkt
              value: cloudy
            - label: Klar
              value: clear-night
            - label: Windig
              value: windy
            - label: Windig mit Wolken
              value: windy-variant
            - label: Regnerisch
              value: rainy
            - label: Starkregen
              value: pouring
            - label: Nebel
              value: fog

    sun_on_delay:
      name: Einschaltverzögerung
      description: >
        Alle Startbedingungen müssen für diese Dauer ununterbrochen erfüllt sein.
      default:
        minutes: 10
      selector:
        duration:

    sun_off_delay:
      name: Ausschaltverzögerung – nur zur Kompatibilität
      description: >
        In Version 2 nicht verwendet. Eine aktive Beschattung wird nicht aufgrund
        von Wolken oder sinkenden Luxwerten beendet.
      default:
        minutes: 20
      selector:
        duration:

    off_hysteresis_percent:
      name: Helligkeits-Hysterese – nur zur Kompatibilität
      description: In Version 2 nicht verwendet.
      default: 25
      selector:
        number:
          min: 0
          max: 60
          step: 1
          unit_of_measurement: "%"

    ventilation_position:
      name: Beschattungs-/Lüftungsposition
      default: 15
      selector:
        number:
          min: 0
          max: 100
          step: 1
          unit_of_measurement: "%"

    open_position:
      name: Offen-Position
      default: 100
      selector:
        number:
          min: 0
          max: 100
          step: 1
          unit_of_measurement: "%"

    closed_position:
      name: Geschlossen-/Nachtposition
      default: 0
      selector:
        number:
          min: 0
          max: 100
          step: 1
          unit_of_measurement: "%"

    position_tolerance:
      name: Positionstoleranz
      description: >
        Toleranz zur Erkennung von offen, geschlossen und Beschattungsposition.
      default: 3
      selector:
        number:
          min: 0
          max: 20
          step: 1
          unit_of_measurement: "%"

    cover_open_settle_delay:
      name: Wartezeit nach vollständigem manuellen Öffnen
      description: >
        Erst danach wird geprüft, ob das vollständig geöffnete Rollo wieder auf
        die Beschattungsposition fahren soll.
      default:
        seconds: 10
      selector:
        duration:

    only_open_if_automation_shaded:
      name: Zur Endzeit nur aus Beschattungsposition öffnen
      description: >
        Empfohlen: eingeschaltet lassen. Dadurch bleiben Nachtposition und manuelle
        Zwischenpositionen unverändert.
      default: true
      selector:
        boolean:

    shading_end_max_position:
      name: Maximale Position, die zur Endzeit noch als Beschattung gilt
      description: >
        Manche Rollos melden die angefahrene Position nicht exakt. Ein Rollo wird
        zur Endzeit geöffnet, wenn es oberhalb der Geschlossenposition und höchstens
        auf diesem Wert steht. Manuelle Positionen wie 50 Prozent bleiben erhalten.
      default: 30
      selector:
        number:
          min: 1
          max: 80
          step: 1
          unit_of_measurement: "%"

mode: restart
max_exceeded: silent

trace:
  stored_traces: 100

trigger_variables:
  illuminance_sensor_t: !input illuminance_sensor
  weather_condition_sensor_t: !input weather_condition_sensor
  cloud_cover_sensor_t: !input cloud_cover_sensor
  outside_temperature_sensor_t: !input outside_temperature_sensor
  inside_temperature_sensor_t: !input inside_temperature_sensor
  minimum_outside_temperature_t: !input minimum_outside_temperature
  minimum_inside_temperature_t: !input minimum_inside_temperature
  minimum_elevation_t: !input minimum_elevation
  minimum_azimuth_t: !input minimum_azimuth
  maximum_azimuth_t: !input maximum_azimuth
  maximum_cloud_cover_t: !input maximum_cloud_cover
  lux_threshold_cloud_0_20_t: !input lux_threshold_cloud_0_20
  lux_threshold_cloud_21_40_t: !input lux_threshold_cloud_21_40
  lux_threshold_cloud_41_60_t: !input lux_threshold_cloud_41_60
  lux_threshold_cloud_61_100_t: !input lux_threshold_cloud_61_100
  allowed_weather_states_t: !input allowed_weather_states
  cover_entity_t: !input cover_entity
  open_position_t: !input open_position
  position_tolerance_t: !input position_tolerance

triggers:
  # Strenger Starttrigger: nur wenn alle Sonnenbedingungen stabil erfüllt sind.
  - trigger: template
    id: automatic_sun_on
    value_template: >
      {% set lux = states(illuminance_sensor_t) | float(-1) %}
      {% set weather = states(weather_condition_sensor_t) %}
      {% set cloud = states(cloud_cover_sensor_t) | float(-1) %}
      {% set outside = states(outside_temperature_sensor_t) | float(-99) %}
      {% set inside = states(inside_temperature_sensor_t) | float(-99) %}
      {% set elevation = state_attr('sun.sun', 'elevation') | float(-90) %}
      {% set azimuth = state_attr('sun.sun', 'azimuth') | float(-1) %}
      {% set threshold =
        lux_threshold_cloud_0_20_t if cloud <= 20 else
        lux_threshold_cloud_21_40_t if cloud <= 40 else
        lux_threshold_cloud_41_60_t if cloud <= 60 else
        lux_threshold_cloud_61_100_t
      %}
      {{
        lux >= 0
        and cloud >= 0
        and weather in allowed_weather_states_t
        and cloud <= maximum_cloud_cover_t
        and elevation >= minimum_elevation_t
        and azimuth >= minimum_azimuth_t
        and azimuth <= maximum_azimuth_t
        and lux >= threshold
        and (
          outside > minimum_outside_temperature_t
          or inside > minimum_inside_temperature_t
        )
      }}
    for: !input sun_on_delay

  # Erkennt, dass das Rollo vollständig geöffnet wurde.
  - trigger: template
    id: cover_fully_opened
    value_template: >
      {% set position = state_attr(cover_entity_t, 'current_position') | int(-1) %}
      {{
        position != -1
        and (position - open_position_t) | abs <= position_tolerance_t
      }}

  # Regelmäßige Nachprüfung nur zum STARTEN, niemals zum Hochfahren.
  - trigger: time_pattern
    minutes: "/10"
    id: periodic_start_check

  - trigger: state
    entity_id: !input master_switch
    id: control_changed

  - trigger: state
    entity_id: !input local_switch
    id: control_changed

  - trigger: state
    entity_id: !input manual_boost_switch
    id: manual_boost_changed

  - trigger: time
    at: !input manual_boost_off_time
    id: manual_boost_off_time

  - trigger: time
    at: !input automation_start_time
    id: automation_start_time

  - trigger: time
    at: !input shading_end_time
    id: shading_end_time

  - trigger: state
    entity_id: !input window_contact
    to: "on"
    id: window_opened

  - trigger: state
    entity_id: !input window_contact
    to: "off"
    id: window_closed

  - trigger: state
    entity_id: !input awning
    from: "closed"
    id: awning_opened

  - trigger: state
    entity_id: !input awning
    to: "closed"
    id: awning_closed

  - trigger: homeassistant
    event: start
    id: home_assistant_start

variables:
  master_switch: !input master_switch
  local_switch: !input local_switch
  manual_boost_switch: !input manual_boost_switch
  automation_start_time: !input automation_start_time
  shading_end_time: !input shading_end_time

  cover_entity: !input cover_entity
  window_contact: !input window_contact
  awning: !input awning

  illuminance_sensor: !input illuminance_sensor
  weather_condition_sensor: !input weather_condition_sensor
  cloud_cover_sensor: !input cloud_cover_sensor
  outside_temperature_sensor: !input outside_temperature_sensor
  inside_temperature_sensor: !input inside_temperature_sensor

  minimum_outside_temperature: !input minimum_outside_temperature
  minimum_inside_temperature: !input minimum_inside_temperature
  minimum_elevation: !input minimum_elevation
  minimum_azimuth: !input minimum_azimuth
  maximum_azimuth: !input maximum_azimuth
  maximum_cloud_cover: !input maximum_cloud_cover

  lux_threshold_cloud_0_20: !input lux_threshold_cloud_0_20
  lux_threshold_cloud_21_40: !input lux_threshold_cloud_21_40
  lux_threshold_cloud_41_60: !input lux_threshold_cloud_41_60
  lux_threshold_cloud_61_100: !input lux_threshold_cloud_61_100
  allowed_weather_states: !input allowed_weather_states

  ventilation_position: !input ventilation_position
  open_position: !input open_position
  closed_position: !input closed_position
  position_tolerance: !input position_tolerance
  only_open_if_automation_shaded: !input only_open_if_automation_shaded
  shading_end_max_position: !input shading_end_max_position

  trigger_id: >
    {{ trigger.id if trigger is defined and trigger.id is defined else 'manual_run' }}

  has_awning: >
    {{ awning != [] and awning != '' and awning is not none }}

  awning_is_closed: >
    {{ not has_awning or is_state(awning, 'closed') }}

  current_position: >
    {{ state_attr(cover_entity, 'current_position') | int(-1) }}

  is_fully_closed: >
    {{
      current_position != -1
      and (current_position - closed_position) | abs <= position_tolerance
    }}

  is_fully_open: >
    {{
      current_position != -1
      and (current_position - open_position) | abs <= position_tolerance
    }}

  is_at_shading_position: >
    {{
      current_position != -1
      and (current_position - ventilation_position) | abs <= position_tolerance
    }}

  is_manual_intermediate_position: >
    {{
      current_position != -1
      and not is_fully_closed
      and not is_fully_open
      and not is_at_shading_position
    }}

  automation_time_active: >
    {% set start = today_at(automation_start_time) %}
    {% set end = today_at(shading_end_time) %}
    {% if start < end %}
      {{ now() >= start and now() < end }}
    {% else %}
      {{ now() >= start or now() < end }}
    {% endif %}

  before_shading_end: >
    {{ automation_time_active }}

  lux: "{{ states(illuminance_sensor) | float(-1) }}"
  weather: "{{ states(weather_condition_sensor) }}"
  cloud: "{{ states(cloud_cover_sensor) | float(-1) }}"
  outside_temperature: "{{ states(outside_temperature_sensor) | float(-99) }}"
  inside_temperature: "{{ states(inside_temperature_sensor) | float(-99) }}"
  elevation: "{{ state_attr('sun.sun', 'elevation') | float(-90) }}"
  azimuth: "{{ state_attr('sun.sun', 'azimuth') | float(-1) }}"

  active_lux_threshold: >
    {{
      lux_threshold_cloud_0_20 if cloud <= 20 else
      lux_threshold_cloud_21_40 if cloud <= 40 else
      lux_threshold_cloud_41_60 if cloud <= 60 else
      lux_threshold_cloud_61_100
    }}

  automatic_conditions_now: >
    {{
      lux >= 0
      and cloud >= 0
      and weather in allowed_weather_states
      and cloud <= maximum_cloud_cover
      and elevation >= minimum_elevation
      and azimuth >= minimum_azimuth
      and azimuth <= maximum_azimuth
      and lux >= active_lux_threshold
      and (
        outside_temperature > minimum_outside_temperature
        or inside_temperature > minimum_inside_temperature
      )
    }}

  # Dynamische Szenen zum Merken der Position vor Fenster-/Markisenöffnung.
  snapshot_base: >
    {{
      cover_entity
      | replace('cover.', '')
      | replace('.', '_')
      | replace('-', '_')
    }}
  window_snapshot_scene: "scene.sunshade_{{ snapshot_base }}_before_window"
  window_snapshot_id: "sunshade_{{ snapshot_base }}_before_window"
  awning_snapshot_scene: "scene.sunshade_{{ snapshot_base }}_before_awning"
  awning_snapshot_id: "sunshade_{{ snapshot_base }}_before_awning"

actions:
  - choose:
      ######################################################################
      # 1. Manuellen Hitzeschutz zur festgelegten Uhrzeit ausschalten
      ######################################################################
      - conditions:
          - condition: template
            value_template: "{{ trigger_id == 'manual_boost_off_time' }}"
        sequence:
          - action: input_boolean.turn_off
            target:
              entity_id: !input manual_boost_switch

          - choose:
              - conditions:
                  - condition: template
                    value_template: >
                      {{
                        is_at_shading_position
                        and before_shading_end
                        and automatic_conditions_now
                      }}
                sequence:
                  - stop: >
                      Manueller Hitzeschutz beendet; automatische
                      Beschattungsbedingungen bestehen weiterhin.

          - choose:
              - conditions:
                  - condition: template
                    value_template: "{{ is_at_shading_position }}"
                sequence:
                  - action: cover.set_cover_position
                    target:
                      entity_id: !input cover_entity
                    data:
                      position: "{{ open_position }}"

          - stop: Manueller Hitzeschutz wurde automatisch ausgeschaltet.

      ######################################################################
      # 2. Automatische Beschattung zur Endzeit beenden
      ######################################################################
      - conditions:
          - condition: template
            value_template: "{{ trigger_id == 'shading_end_time' }}"
        sequence:
          - action: input_boolean.turn_off
            target:
              entity_id: !input manual_boost_switch

          - choose:
              - conditions:
                  - condition: template
                    value_template: >
                      {{
                        not only_open_if_automation_shaded
                        or is_at_shading_position
                        or (
                          current_position > closed_position + position_tolerance
                          and current_position <= shading_end_max_position
                        )
                      }}
                sequence:
                  - action: cover.set_cover_position
                    target:
                      entity_id: !input cover_entity
                    data:
                      position: "{{ open_position }}"

          - stop: Beschattungs-Endzeit wurde erreicht.

      ######################################################################
      # 3. Beginn der Tagesfreigabe
      #
      # Um 09:00 Uhr (oder zur eingestellten Startzeit) wird nur geprüft,
      # ob ein vollständig geöffnetes Rollo jetzt beschattet werden muss.
      # Geschlossene und manuelle Zwischenpositionen bleiben unverändert.
      ######################################################################
      - conditions:
          - condition: template
            value_template: "{{ trigger_id == 'automation_start_time' }}"
        sequence:
          - choose:
              - conditions:
                  - condition: template
                    value_template: "{{ is_fully_open }}"
                  - condition: template
                    value_template: "{{ automatic_conditions_now }}"
                  - condition: template
                    value_template: "{{ is_state(window_contact, 'off') }}"
                  - condition: template
                    value_template: "{{ awning_is_closed }}"
                sequence:
                  - action: cover.set_cover_position
                    target:
                      entity_id: !input cover_entity
                    data:
                      position: "{{ ventilation_position }}"

          - stop: Tagesfreigabe der Sonnenschutz-Automatik wurde geprüft.

      ######################################################################
      # 4. Nachtsperre
      #
      # Außerhalb des Zeitfensters (standardmäßig 18:00 bis 09:00 Uhr)
      # führt dieser Blueprint keinerlei Rollo-Bewegungen aus.
      ######################################################################
      - conditions:
          - condition: template
            value_template: "{{ not automation_time_active }}"
        sequence:
          - stop: Nachtsperre ist aktiv.

      ######################################################################
      # 5. Master- oder Raumschalter AUS: keine automatische Bewegung
      ######################################################################
      - conditions:
          - condition: template
            value_template: >
              {{
                is_state(master_switch, 'off')
                or is_state(local_switch, 'off')
              }}
        sequence:
          - stop: Sonnenschutz ist über einen Schalter deaktiviert.

      ######################################################################
      # 6. Fenster wird geöffnet:
      #    aktuelle Position speichern und Rollo vollständig öffnen
      ######################################################################
      - conditions:
          - condition: template
            value_template: "{{ trigger_id == 'window_opened' }}"
        sequence:
          - action: scene.create
            data:
              scene_id: "{{ window_snapshot_id }}"
              snapshot_entities:
                - !input cover_entity

          - action: cover.set_cover_position
            target:
              entity_id: !input cover_entity
            data:
              position: "{{ open_position }}"

          - stop: Fenster geöffnet; vorherige Rollo-Position wurde gespeichert.

      ######################################################################
      # 7. Markise wird ausgefahren:
      #    aktuelle Position speichern und Rollo vollständig öffnen
      ######################################################################
      - conditions:
          - condition: template
            value_template: >
              {{ trigger_id == 'awning_opened' and has_awning }}
        sequence:
          - action: scene.create
            data:
              scene_id: "{{ awning_snapshot_id }}"
              snapshot_entities:
                - !input cover_entity

          - action: cover.set_cover_position
            target:
              entity_id: !input cover_entity
            data:
              position: "{{ open_position }}"

          - stop: Markise ausgefahren; vorherige Rollo-Position wurde gespeichert.

      ######################################################################
      # 8. Fenster wird geschlossen:
      #    vorherige Position wiederherstellen, sofern Markise eingefahren ist
      ######################################################################
      - conditions:
          - condition: template
            value_template: >
              {{
                trigger_id == 'window_closed'
                and awning_is_closed
              }}
        sequence:
          - choose:
              - conditions:
                  - condition: template
                    value_template: >
                      {{
                        states(window_snapshot_scene)
                        not in ['unknown', 'unavailable']
                      }}
                sequence:
                  - action: scene.turn_on
                    target:
                      entity_id: "{{ window_snapshot_scene }}"

                  - delay:
                      seconds: 3

                  - choose:
                      - conditions:
                          - condition: template
                            value_template: >
                              {{
                                not before_shading_end
                                and (
                                  state_attr(cover_entity, 'current_position')
                                  | int(-1)
                                  - ventilation_position
                                ) | abs <= position_tolerance
                              }}
                        sequence:
                          - action: cover.set_cover_position
                            target:
                              entity_id: !input cover_entity
                            data:
                              position: "{{ open_position }}"

                  - stop: Position vor der Fensteröffnung wurde wiederhergestellt.

          - choose:
              - conditions:
                  - condition: template
                    value_template: >
                      {{
                        before_shading_end
                        and automatic_conditions_now
                      }}
                sequence:
                  - action: cover.set_cover_position
                    target:
                      entity_id: !input cover_entity
                    data:
                      position: "{{ ventilation_position }}"

          - stop: Fenster geschlossen; keine gespeicherte Position vorhanden.

      ######################################################################
      # 9. Markise wird eingefahren:
      #    vorherige Position wiederherstellen, sofern Fenster geschlossen ist
      ######################################################################
      - conditions:
          - condition: template
            value_template: >
              {{
                trigger_id == 'awning_closed'
                and is_state(window_contact, 'off')
              }}
        sequence:
          - choose:
              - conditions:
                  - condition: template
                    value_template: >
                      {{
                        states(awning_snapshot_scene)
                        not in ['unknown', 'unavailable']
                      }}
                sequence:
                  - action: scene.turn_on
                    target:
                      entity_id: "{{ awning_snapshot_scene }}"

                  - delay:
                      seconds: 3

                  - choose:
                      - conditions:
                          - condition: template
                            value_template: >
                              {{
                                not before_shading_end
                                and (
                                  state_attr(cover_entity, 'current_position')
                                  | int(-1)
                                  - ventilation_position
                                ) | abs <= position_tolerance
                              }}
                        sequence:
                          - action: cover.set_cover_position
                            target:
                              entity_id: !input cover_entity
                            data:
                              position: "{{ open_position }}"

                  - stop: Position vor dem Ausfahren der Markise wurde wiederhergestellt.

          - choose:
              - conditions:
                  - condition: template
                    value_template: >
                      {{
                        before_shading_end
                        and automatic_conditions_now
                      }}
                sequence:
                  - action: cover.set_cover_position
                    target:
                      entity_id: !input cover_entity
                    data:
                      position: "{{ ventilation_position }}"

          - stop: Markise eingefahren; keine gespeicherte Position vorhanden.

      ######################################################################
      # 10. Geschlossen/Nacht: Automatik greift nicht ein
      #
      # Ein periodischer Startcheck darf ein nachts geschlossenes Rollo
      # niemals wegen eines offenen Fensters oder einer Markise öffnen.
      ######################################################################
      - conditions:
          - condition: template
            value_template: "{{ is_fully_closed }}"
        sequence:
          - stop: Rollo ist vollständig geschlossen; Nacht-/Schlafposition wird respektiert.

      ######################################################################
      # 11. Manueller Hitzeschutz
      ######################################################################
      - conditions:
          - condition: template
            value_template: >
              {{
                is_state(manual_boost_switch, 'on')
                and is_state(window_contact, 'off')
                and awning_is_closed
              }}
        sequence:
          - action: cover.set_cover_position
            target:
              entity_id: !input cover_entity
            data:
              position: "{{ ventilation_position }}"
          - stop: Manueller Hitzeschutz ist aktiv.

      ######################################################################
      # 12. Manuelle Zwischenpositionen respektieren
      ######################################################################
      - conditions:
          - condition: template
            value_template: "{{ is_manual_intermediate_position }}"
        sequence:
          - stop: Manuell gewählte Zwischenposition wird respektiert.

      ######################################################################
      # 13. Rollo wurde vollständig geöffnet:
      #     Nach kurzer Motor-Wartezeit Sonnenschutz erneut prüfen
      ######################################################################
      - conditions:
          - condition: template
            value_template: "{{ trigger_id == 'cover_fully_opened' }}"
        sequence:
          - delay: !input cover_open_settle_delay

          - variables:
              position_after_wait: >
                {{ state_attr(cover_entity, 'current_position') | int(-1) }}

          - condition: template
            value_template: >
              {{
                (position_after_wait - open_position) | abs <= position_tolerance
              }}

          - condition: template
            value_template: "{{ before_shading_end }}"

          - condition: template
            value_template: "{{ automatic_conditions_now }}"

          - condition: template
            value_template: "{{ is_state(window_contact, 'off') }}"

          - condition: template
            value_template: "{{ awning_is_closed }}"

          - action: cover.set_cover_position
            target:
              entity_id: !input cover_entity
            data:
              position: "{{ ventilation_position }}"

          - stop: Vollständig geöffnetes Rollo wurde auf Sonnenschutzposition gesetzt.

      ######################################################################
      # 14. Neue automatische Beschattung starten
      #     Gilt für Template-Trigger und periodische Nachprüfung.
      ######################################################################
      - conditions:
          - condition: template
            value_template: >
              {{
                trigger_id in [
                  'automatic_sun_on',
                  'automation_start_time',
                  'periodic_start_check',
                  'control_changed',
                  'home_assistant_start',
                  'manual_run'
                ]
              }}

          - condition: template
            value_template: "{{ before_shading_end }}"

          - condition: template
            value_template: "{{ automatic_conditions_now }}"

          - condition: template
            value_template: "{{ is_fully_open }}"

          - condition: template
            value_template: "{{ is_state(window_contact, 'off') }}"

          - condition: template
            value_template: "{{ awning_is_closed }}"
        sequence:
          - action: cover.set_cover_position
            target:
              entity_id: !input cover_entity
            data:
              position: "{{ ventilation_position }}"

          - stop: Automatische Beschattung wurde gestartet.

    default:
      - stop: Keine Aktion erforderlich.
