blueprint:
  name: Homematic HM-PB-6-WM55 – 6 Tasten Kurz/Lang
  description: >
    Blueprint für den Homematic HM-PB-6-WM55 6-fach Wandtaster
    über Homematic(IP) Local for OpenCCU.

    Es wird nur der Homematic-Taster als Gerät ausgewählt.

    Für jede der 6 Tasten können unabhängig Aktionen für
    kurzen und langen Tastendruck definiert werden.

    Alle Aktionen sind optional und können leer bleiben.
    Als Aktion kann jede Home-Assistant-Aktion verwendet werden,
    z. B. Toggle, Ein, Aus, KNX-Licht, Szene, Rollo oder Skript.

  domain: automation

  homeassistant:
    min_version: 2026.8.0

  input:
    remote:
      name: Homematic 6-fach Taster
      description: Wähle deinen HM-PB-6-WM55 aus.
      selector:
        device:
          filter:
            - integration: homematicip_local
              model: HM-PB-6-WM55

    button_1_short:
      name: "Taste 1 – Kurz"
      default: []
      selector:
        action:

    button_1_long:
      name: "Taste 1 – Lang"
      default: []
      selector:
        action:

    button_2_short:
      name: "Taste 2 – Kurz"
      default: []
      selector:
        action:

    button_2_long:
      name: "Taste 2 – Lang"
      default: []
      selector:
        action:

    button_3_short:
      name: "Taste 3 – Kurz"
      default: []
      selector:
        action:

    button_3_long:
      name: "Taste 3 – Lang"
      default: []
      selector:
        action:

    button_4_short:
      name: "Taste 4 – Kurz"
      default: []
      selector:
        action:

    button_4_long:
      name: "Taste 4 – Lang"
      default: []
      selector:
        action:

    button_5_short:
      name: "Taste 5 – Kurz"
      default: []
      selector:
        action:

    button_5_long:
      name: "Taste 5 – Lang"
      default: []
      selector:
        action:

    button_6_short:
      name: "Taste 6 – Kurz"
      default: []
      selector:
        action:

    button_6_long:
      name: "Taste 6 – Lang"
      default: []
      selector:
        action:


triggers:
  - trigger: event.received
    target:
      device_id: !input remote
    options:
      event_type:
        - press_short
        - press_long


conditions: []


actions:
  - variables:
      event_type: "{{ trigger.event_type }}"
      channel_no: "{{ trigger.entity.attributes.channel_no | int }}"

  - choose:

      # TASTE 1
      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 1 and event_type == 'press_short' }}
        sequence: !input button_1_short

      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 1 and event_type == 'press_long' }}
        sequence: !input button_1_long


      # TASTE 2
      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 2 and event_type == 'press_short' }}
        sequence: !input button_2_short

      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 2 and event_type == 'press_long' }}
        sequence: !input button_2_long


      # TASTE 3
      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 3 and event_type == 'press_short' }}
        sequence: !input button_3_short

      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 3 and event_type == 'press_long' }}
        sequence: !input button_3_long


      # TASTE 4
      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 4 and event_type == 'press_short' }}
        sequence: !input button_4_short

      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 4 and event_type == 'press_long' }}
        sequence: !input button_4_long


      # TASTE 5
      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 5 and event_type == 'press_short' }}
        sequence: !input button_5_short

      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 5 and event_type == 'press_long' }}
        sequence: !input button_5_long


      # TASTE 6
      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 6 and event_type == 'press_short' }}
        sequence: !input button_6_short

      - conditions:
          - condition: template
            value_template: >
              {{ channel_no == 6 and event_type == 'press_long' }}
        sequence: !input button_6_long


mode: queued
max: 10
