blueprint:
  name: Homematic HM-PB-6-WM55 – 6 Tasten Kurz/Lang
  description: >
    Universeller Blueprint für den Homematic HM-PB-6-WM55 6-fach Wandtaster
    über Homematic(IP) Local / CCU.

    Unterstützt alle 6 Kanäle (ch1 bis ch6) mit:
      - kurzem Tastendruck (press_short)
      - langem Tastendruck (press_long)

    Für jede Taste können beliebige Home-Assistant-Aktionen hinterlegt werden,
    z. B. Licht umschalten (Toggle), Ein/Aus, KNX, Szenen, Rollos oder Skripte.

    Nicht benötigte Aktionen können einfach leer bleiben.

    Hinweis:
    press_cont und press_long_release werden bewusst nicht ausgewertet.

  domain: automation

  input:

    channel_1:
      name: Taste 1 – ch1
      description: Event-Entität von Kanal 1
      selector:
        entity:
          filter:
            - domain: event
              device_class: button

    channel_2:
      name: Taste 2 – ch2
      description: Event-Entität von Kanal 2
      selector:
        entity:
          filter:
            - domain: event
              device_class: button

    channel_3:
      name: Taste 3 – ch3
      description: Event-Entität von Kanal 3
      selector:
        entity:
          filter:
            - domain: event
              device_class: button

    channel_4:
      name: Taste 4 – ch4
      description: Event-Entität von Kanal 4
      selector:
        entity:
          filter:
            - domain: event
              device_class: button

    channel_5:
      name: Taste 5 – ch5
      description: Event-Entität von Kanal 5
      selector:
        entity:
          filter:
            - domain: event
              device_class: button

    channel_6:
      name: Taste 6 – ch6
      description: Event-Entität von Kanal 6
      selector:
        entity:
          filter:
            - domain: event
              device_class: button


    # ---------------------------------------------------------
    # TASTE 1
    # ---------------------------------------------------------

    button_1_short:
      name: Taste 1 – Kurz
      description: Aktion bei kurzem Tastendruck
      default: []
      selector:
        action:

    button_1_long:
      name: Taste 1 – Lang
      description: Aktion bei langem Tastendruck
      default: []
      selector:
        action:


    # ---------------------------------------------------------
    # TASTE 2
    # ---------------------------------------------------------

    button_2_short:
      name: Taste 2 – Kurz
      description: Aktion bei kurzem Tastendruck
      default: []
      selector:
        action:

    button_2_long:
      name: Taste 2 – Lang
      description: Aktion bei langem Tastendruck
      default: []
      selector:
        action:


    # ---------------------------------------------------------
    # TASTE 3
    # ---------------------------------------------------------

    button_3_short:
      name: Taste 3 – Kurz
      description: Aktion bei kurzem Tastendruck
      default: []
      selector:
        action:

    button_3_long:
      name: Taste 3 – Lang
      description: Aktion bei langem Tastendruck
      default: []
      selector:
        action:


    # ---------------------------------------------------------
    # TASTE 4
    # ---------------------------------------------------------

    button_4_short:
      name: Taste 4 – Kurz
      description: Aktion bei kurzem Tastendruck
      default: []
      selector:
        action:

    button_4_long:
      name: Taste 4 – Lang
      description: Aktion bei langem Tastendruck
      default: []
      selector:
        action:


    # ---------------------------------------------------------
    # TASTE 5
    # ---------------------------------------------------------

    button_5_short:
      name: Taste 5 – Kurz
      description: Aktion bei kurzem Tastendruck
      default: []
      selector:
        action:

    button_5_long:
      name: Taste 5 – Lang
      description: Aktion bei langem Tastendruck
      default: []
      selector:
        action:


    # ---------------------------------------------------------
    # TASTE 6
    # ---------------------------------------------------------

    button_6_short:
      name: Taste 6 – Kurz
      description: Aktion bei kurzem Tastendruck
      default: []
      selector:
        action:

    button_6_long:
      name: Taste 6 – Lang
      description: Aktion bei langem Tastendruck
      default: []
      selector:
        action:


mode: queued
max: 10


# =============================================================
# TRIGGER
# =============================================================

triggers:

  # Taste 1
  - trigger: state
    entity_id: !input channel_1
    attribute: event_type
    to: press_short
    id: button_1_short

  - trigger: state
    entity_id: !input channel_1
    attribute: event_type
    to: press_long
    id: button_1_long


  # Taste 2
  - trigger: state
    entity_id: !input channel_2
    attribute: event_type
    to: press_short
    id: button_2_short

  - trigger: state
    entity_id: !input channel_2
    attribute: event_type
    to: press_long
    id: button_2_long


  # Taste 3
  - trigger: state
    entity_id: !input channel_3
    attribute: event_type
    to: press_short
    id: button_3_short

  - trigger: state
    entity_id: !input channel_3
    attribute: event_type
    to: press_long
    id: button_3_long


  # Taste 4
  - trigger: state
    entity_id: !input channel_4
    attribute: event_type
    to: press_short
    id: button_4_short

  - trigger: state
    entity_id: !input channel_4
    attribute: event_type
    to: press_long
    id: button_4_long


  # Taste 5
  - trigger: state
    entity_id: !input channel_5
    attribute: event_type
    to: press_short
    id: button_5_short

  - trigger: state
    entity_id: !input channel_5
    attribute: event_type
    to: press_long
    id: button_5_long


  # Taste 6
  - trigger: state
    entity_id: !input channel_6
    attribute: event_type
    to: press_short
    id: button_6_short

  - trigger: state
    entity_id: !input channel_6
    attribute: event_type
    to: press_long
    id: button_6_long


# =============================================================
# AKTIONEN
# =============================================================

actions:

  - choose:

      # Taste 1
      - conditions:
          - condition: trigger
            id: button_1_short
        sequence: !input button_1_short

      - conditions:
          - condition: trigger
            id: button_1_long
        sequence: !input button_1_long


      # Taste 2
      - conditions:
          - condition: trigger
            id: button_2_short
        sequence: !input button_2_short

      - conditions:
          - condition: trigger
            id: button_2_long
        sequence: !input button_2_long


      # Taste 3
      - conditions:
          - condition: trigger
            id: button_3_short
        sequence: !input button_3_short

      - conditions:
          - condition: trigger
            id: button_3_long
        sequence: !input button_3_long


      # Taste 4
      - conditions:
          - condition: trigger
            id: button_4_short
        sequence: !input button_4_short

      - conditions:
          - condition: trigger
            id: button_4_long
        sequence: !input button_4_long


      # Taste 5
      - conditions:
          - condition: trigger
            id: button_5_short
        sequence: !input button_5_short

      - conditions:
          - condition: trigger
            id: button_5_long
        sequence: !input button_5_long


      # Taste 6
      - conditions:
          - condition: trigger
            id: button_6_short
        sequence: !input button_6_short

      - conditions:
          - condition: trigger
            id: button_6_long
        sequence: !input button_6_long
