blueprint:
  name: Garage - Hauptlicht und Zusatzleuchten ohne Templates
  domain: automation
  input:
    open_sensors:
      name: Tür-/Torsensoren
      selector:
        entity:
          multiple: true

    main_light:
      name: Hauptlicht Garage
      selector:
        entity:
          domain:
            - light
            - switch

    extra_lights:
      name: Zusatzleuchten
      selector:
        entity:
          domain:
            - light
            - switch
          multiple: true

    motion_sensor:
      name: Bewegungsmelder
      selector:
        entity:
          domain: binary_sensor

    lux_sensor:
      name: Helligkeitssensor
      selector:
        entity:
          domain: sensor

    lux_threshold:
      name: Helligkeitsschwellenwert
      default: 30
      selector:
        number:
          min: 0
          max: 500
          step: 1
          unit_of_measurement: lx

    main_on_time:
      name: Hauptlicht Einschaltdauer
      default:
        minutes: 20
      selector:
        duration:

    extra_on_time:
      name: Zusatzleuchten Nachlaufzeit
      default:
        minutes: 3
      selector:
        duration:

mode: parallel
max: 10

trigger:
  - platform: state
    entity_id: !input open_sensors
    to: "on"
    id: door

  - platform: state
    entity_id: !input open_sensors
    to: "open"
    id: door

  - platform: state
    entity_id: !input open_sensors
    to: "opened"
    id: door

  - platform: state
    entity_id: !input motion_sensor
    to: "on"
    id: motion

  - platform: state
    entity_id: !input main_light
    to: "on"
    id: manual

action:
  - choose:
      - conditions:
          - condition: trigger
            id: door
        sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: !input main_light

          - if:
              - condition: numeric_state
                entity_id: !input lux_sensor
                below: !input lux_threshold
            then:
              - service: homeassistant.turn_on
                target:
                  entity_id: !input extra_lights
              - delay: !input extra_on_time
              - service: homeassistant.turn_off
                target:
                  entity_id: !input extra_lights

          - delay: !input main_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input main_light

      - conditions:
          - condition: trigger
            id: motion
          - condition: numeric_state
            entity_id: !input lux_sensor
            below: !input lux_threshold
        sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: !input extra_lights
          - delay: !input extra_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input extra_lights

      - conditions:
          - condition: trigger
            id: manual
        sequence:
          - delay: !input main_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input main_light

