blueprint:
  name: Garage - Hauptlicht und Zusatzleuchten
  description: Hauptlicht bei Tür/Tor oder manuell. Zusatzleuchten bei Tür/Tor oder Bewegung nur bei Dunkelheit.
  domain: automation
  input:
    open_sensors:
      name: Tür-/Torsensoren
      selector:
        entity:
          multiple: true

    main_light:
      name: Hauptlicht Garage
      selector:
        entity:
          domain:
            - light
            - switch

    extra_lights:
      name: Zusatzleuchten
      selector:
        entity:
          domain:
            - light
            - switch
          multiple: true

    motion_sensor:
      name: Bewegungsmelder für Zusatzleuchten
      selector:
        entity:
          domain: binary_sensor

    lux_sensor:
      name: Helligkeitssensor
      selector:
        entity:
          domain: sensor

    lux_threshold:
      name: Dunkelheitsgrenze in Lux
      default: 30
      selector:
        number:
          min: 0
          max: 500
          step: 1
          unit_of_measurement: lx

    main_max_on_time:
      name: Hauptlicht maximale Einschaltdauer
      default:
        minutes: 20
      selector:
        duration:

    extra_on_time:
      name: Zusatzleuchten Nachlaufzeit
      default:
        minutes: 3
      selector:
        duration:

mode: restart
max_exceeded: silent

variables:
  open_sensors: !input open_sensors
  motion_sensor: !input motion_sensor
  lux_sensor: !input lux_sensor
  lux_threshold: !input lux_threshold

trigger:
  - platform: state
    entity_id: !input open_sensors

  - platform: state
    entity_id: !input main_light
    to: "on"

  - platform: state
    entity_id: !input motion_sensor
    to: "on"

action:
  - choose:
      - conditions:
          - condition: template
            value_template: >
              {{ trigger.entity_id in open_sensors
                 and trigger.to_state is not none
                 and (trigger.to_state.state | lower) not in ['off', 'closed', '0', 'unavailable', 'unknown'] }}
        sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: !input main_light

          - if:
              - condition: template
                value_template: >
                  {{ (states(lux_sensor) | float(9999)) < lux_threshold }}
            then:
              - service: homeassistant.turn_on
                target:
                  entity_id: !input extra_lights

      - conditions:
          - condition: template
            value_template: >
              {{ trigger.entity_id == motion_sensor }}
          - condition: template
            value_template: >
              {{ (states(lux_sensor) | float(9999)) < lux_threshold }}
        sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: !input extra_lights

      - conditions:
          - condition: template
            value_template: >
              {{ trigger.entity_id == expand([!input main_light])[0].entity_id }}
        sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: !input main_light

  - parallel:
      - sequence:
          - delay: !input main_max_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input main_light

      - sequence:
          - wait_for_trigger:
              - platform: state
                entity_id: !input motion_sensor
                to: "off"
                for: !input extra_on_time
            timeout: !input extra_on_time
            continue_on_timeout: true

          - service: homeassistant.turn_off
            target:
              entity_id: !input extra_lights
