blueprint:
  name: Garage - Licht mit Zusatzleuchten bei Dunkelheit
  domain: automation
  input:
    open_sensors:
      name: Tür-/Torsensoren
      selector:
        entity:
          multiple: true

    main_light:
      name: Hauptlicht Garage
      selector:
        entity:
          domain:
            - light
            - switch

    extra_lights:
      name: Zusatzleuchten bei Dunkelheit
      selector:
        entity:
          domain:
            - light
            - switch
          multiple: true

    lux_sensor:
      name: Helligkeitssensor
      selector:
        entity:
          domain: sensor

    lux_threshold:
      name: Dunkelheitsgrenze in Lux
      default: 30
      selector:
        number:
          min: 0
          max: 500
          step: 1
          unit_of_measurement: lx

    main_max_on_time:
      name: Hauptlicht maximale Einschaltdauer
      default:
        minutes: 20
      selector:
        duration:

    extra_on_time:
      name: Zusatzleuchten Einschaltdauer
      default:
        minutes: 3
      selector:
        duration:

mode: restart
max_exceeded: silent

variables:
  open_sensors: !input open_sensors
  lux_sensor: !input lux_sensor
  lux_threshold: !input lux_threshold

trigger:
  - platform: state
    entity_id: !input open_sensors
  - platform: state
    entity_id: !input main_light
    to: "on"

condition:
  - condition: template
    value_template: >
      {{ trigger.entity_id not in open_sensors
         or (trigger.to_state is not none
         and (trigger.to_state.state | lower) not in ['off', 'closed', '0', 'unavailable', 'unknown']) }}

action:
  - parallel:
      - sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: !input main_light
          - delay: !input main_max_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input main_light

      - sequence:
          - condition: template
            value_template: >
              {{ trigger.entity_id in open_sensors
                 and (states(lux_sensor) | float(9999)) < lux_threshold }}
          - service: homeassistant.turn_on
            target:
              entity_id: !input extra_lights
          - delay: !input extra_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input extra_lights
