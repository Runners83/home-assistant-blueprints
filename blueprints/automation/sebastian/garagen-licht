blueprint:
  name: Garage - Hauptlicht und Zusatzleuchten komplett
  domain: automation
  input:
    open_sensors:
      name: Tür-/Torsensoren
      selector:
        entity:
          multiple: true

    main_light:
      name: Hauptlicht Garage
      selector:
        entity:
          domain:
            - light
            - switch

    extra_lights:
      name: Zusatzleuchten
      selector:
        entity:
          domain:
            - light
            - switch
          multiple: true

    motion_sensor:
      name: Bewegungsmelder für Zusatzleuchten
      selector:
        entity:
          domain: binary_sensor

    lux_sensor:
      name: Helligkeitssensor
      selector:
        entity:
          domain: sensor

    lux_threshold:
      name: Dunkelheitsgrenze in Lux
      default: 30
      selector:
        number:
          min: 0
          max: 500
          step: 1
          unit_of_measurement: lx

    main_max_on_time:
      name: Hauptlicht maximale Einschaltdauer
      default:
        minutes: 20
      selector:
        duration:

    extra_on_time:
      name: Zusatzleuchten Nachlaufzeit
      default:
        minutes: 3
      selector:
        duration:

mode: restart
max_exceeded: silent

variables:
  lux_sensor_entity: !input lux_sensor
  lux_limit: !input lux_threshold

trigger:
  - platform: state
    entity_id: !input open_sensors
    id: door

  - platform: state
    entity_id: !input main_light
    to: "on"
    id: main_manual

  - platform: state
    entity_id: !input motion_sensor
    to: "on"
    id: motion

action:
  - choose:
      - conditions:
          - condition: trigger
            id: door
          - condition: template
            value_template: >
              {{ trigger.to_state.state | lower not in ['off', 'closed', '0', 'unknown', 'unavailable'] }}
        sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: !input main_light

          - if:
              - condition: template
                value_template: >
                  {{ states(lux_sensor_entity) | float(9999) < lux_limit }}
            then:
              - service: homeassistant.turn_on
                target:
                  entity_id: !input extra_lights
              - delay: !input extra_on_time
              - service: homeassistant.turn_off
                target:
                  entity_id: !input extra_lights

          - delay: !input main_max_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input main_light

      - conditions:
          - condition: trigger
            id: motion
          - condition: template
            value_template: >
              {{ states(lux_sensor_entity) | float(9999) < lux_limit }}
        sequence:
          - service: homeassistant.turn_on
            target:
              entity_id: !input extra_lights
          - delay: !input extra_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input extra_lights

      - conditions:
          - condition: trigger
            id: main_manual
        sequence:
          - delay: !input main_max_on_time
          - service: homeassistant.turn_off
            target:
              entity_id: !input main_light
