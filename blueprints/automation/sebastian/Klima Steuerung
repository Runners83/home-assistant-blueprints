blueprint:
  name: Klima externes Thermostat mit Nachtmodus
  description: >
    Reine Kühlsteuerung für Klimaanlagen mit externem Temperatursensor,
    Hysterese, Aktiv-Schalter, Nachtmodus, Tag-/Nacht-Lüfterstufe,
    Tag-/Nacht-Mindestlaufzeit und optionalem Fensterkontakt.
  domain: automation

  input:
    climate_entity:
      name: Klimaanlage
      selector:
        entity:
          domain: climate

    temperature_sensor:
      name: Externer Temperatursensor
      selector:
        entity:
          domain: sensor
          device_class: temperature

    enable_boolean:
      name: Aktiv-Schalter
      selector:
        entity:
          domain: input_boolean

    night_mode_boolean:
      name: Nachtmodus-Schalter
      selector:
        entity:
          domain: input_boolean

    target_temperature:
      name: Gewünschte Raumtemperatur
      default: 23
      selector:
        number:
          min: 16
          max: 31
          step: 0.1
          unit_of_measurement: °C

    hysteresis:
      name: Hysterese
      default: 0.5
      selector:
        number:
          min: 0.1
          max: 5
          step: 0.1
          unit_of_measurement: °C

    ac_set_temperature:
      name: Zieltemperatur an der Klimaanlage
      default: 16
      selector:
        number:
          min: 16
          max: 31
          step: 1
          unit_of_measurement: °C

    day_fan_mode:
      name: Lüftermodus am Tag
      default: high
      selector:
        select:
          options:
            - low
            - mid
            - high
            - auto

    night_fan_mode:
      name: Lüftermodus nachts
      default: low
      selector:
        select:
          options:
            - low
            - mid
            - high
            - auto

    day_min_run_minutes:
      name: Mindestlaufzeit am Tag
      default: 10
      selector:
        number:
          min: 0
          max: 180
          step: 1
          unit_of_measurement: min

    day_min_off_minutes:
      name: Mindestpause am Tag
      default: 5
      selector:
        number:
          min: 0
          max: 180
          step: 1
          unit_of_measurement: min

    night_min_run_minutes:
      name: Mindestlaufzeit nachts
      default: 30
      selector:
        number:
          min: 0
          max: 240
          step: 1
          unit_of_measurement: min

    night_min_off_minutes:
      name: Mindestpause nachts
      default: 20
      selector:
        number:
          min: 0
          max: 240
          step: 1
          unit_of_measurement: min

    stable_for_minutes:
      name: Temperatur muss Grenzwert so lange halten
      default: 2
      selector:
        number:
          min: 0
          max: 60
          step: 1
          unit_of_measurement: min

    window_contacts:
      name: Fensterkontakte optional
      default: []
      selector:
        entity:
          domain: binary_sensor
          multiple: true

mode: restart

trigger:
  - platform: state
    entity_id: !input temperature_sensor
    for:
      minutes: !input stable_for_minutes

  - platform: state
    entity_id: !input enable_boolean

  - platform: state
    entity_id: !input night_mode_boolean

  - platform: state
    entity_id: !input window_contacts

variables:
  climate_entity: !input climate_entity
  temperature_sensor: !input temperature_sensor
  enable_boolean: !input enable_boolean
  night_mode_boolean: !input night_mode_boolean
  target_temperature: !input target_temperature
  hysteresis: !input hysteresis
  ac_set_temperature: !input ac_set_temperature
  day_fan_mode: !input day_fan_mode
  night_fan_mode: !input night_fan_mode
  day_min_run_minutes: !input day_min_run_minutes
  day_min_off_minutes: !input day_min_off_minutes
  night_min_run_minutes: !input night_min_run_minutes
  night_min_off_minutes: !input night_min_off_minutes
  window_contacts: !input window_contacts

  current_temp: "{{ states(temperature_sensor) | float(none) }}"
  upper_limit: "{{ target_temperature | float + hysteresis | float }}"
  lower_limit: "{{ target_temperature | float - hysteresis | float }}"

  enabled: "{{ is_state(enable_boolean, 'on') }}"
  night_mode: "{{ is_state(night_mode_boolean, 'on') }}"

  climate_state: "{{ states(climate_entity) }}"
  climate_is_cooling: "{{ is_state(climate_entity, 'cool') }}"

  active_fan_mode: >
    {% if night_mode %}
      {{ night_fan_mode }}
    {% else %}
      {{ day_fan_mode }}
    {% endif %}

  active_min_run_minutes: >
    {% if night_mode %}
      {{ night_min_run_minutes }}
    {% else %}
      {{ day_min_run_minutes }}
    {% endif %}

  active_min_off_minutes: >
    {% if night_mode %}
      {{ night_min_off_minutes }}
    {% else %}
      {{ day_min_off_minutes }}
    {% endif %}

  window_open: >
    {% if window_contacts | count == 0 %}
      false
    {% else %}
      {{ expand(window_contacts) | selectattr('state', 'eq', 'on') | list | count > 0 }}
    {% endif %}

  seconds_since_climate_state_change: >
    {{ (as_timestamp(now()) - as_timestamp(states[climate_entity].last_changed)) | int(0) }}

  min_run_ok: >
    {{ seconds_since_climate_state_change >= (active_min_run_minutes | int * 60) }}

  min_off_ok: >
    {{ seconds_since_climate_state_change >= (active_min_off_minutes | int * 60) }}

action:
  - choose:
      # Aus, wenn deaktiviert oder Fenster offen
      - conditions:
          - condition: template
            value_template: "{{ not enabled or window_open }}"
          - condition: template
            value_template: "{{ climate_state != 'off' }}"
        sequence:
          - service: climate.set_hvac_mode
            target:
              entity_id: !input climate_entity
            data:
              hvac_mode: "off"

      # Ausschalten, wenn kühl genug und Mindestlaufzeit erreicht
      - conditions:
          - condition: template
            value_template: "{{ enabled }}"
          - condition: template
            value_template: "{{ not window_open }}"
          - condition: template
            value_template: "{{ climate_is_cooling }}"
          - condition: template
            value_template: "{{ current_temp is not none }}"
          - condition: template
            value_template: "{{ current_temp <= lower_limit }}"
          - condition: template
            value_template: "{{ min_run_ok }}"
        sequence:
          - service: climate.set_hvac_mode
            target:
              entity_id: !input climate_entity
            data:
              hvac_mode: "off"

      # Einschalten, wenn zu warm und Mindestpause erreicht
      - conditions:
          - condition: template
            value_template: "{{ enabled }}"
          - condition: template
            value_template: "{{ not window_open }}"
          - condition: template
            value_template: "{{ not climate_is_cooling }}"
          - condition: template
            value_template: "{{ current_temp is not none }}"
          - condition: template
            value_template: "{{ current_temp >= upper_limit }}"
          - condition: template
            value_template: "{{ min_off_ok }}"
        sequence:
          - service: climate.set_hvac_mode
            target:
              entity_id: !input climate_entity
            data:
              hvac_mode: cool

          - delay:
              seconds: 1

          - service: climate.set_temperature
            target:
              entity_id: !input climate_entity
            data:
              temperature: !input ac_set_temperature

          - delay:
              seconds: 1

          - service: climate.set_fan_mode
            target:
              entity_id: !input climate_entity
            data:
              fan_mode: "{{ active_fan_mode }}"

      # Wenn bereits an: Temperatur und Lüftermodus nachziehen,
      # z. B. beim Umschalten in den Nachtmodus
      - conditions:
          - condition: template
            value_template: "{{ enabled }}"
          - condition: template
            value_template: "{{ not window_open }}"
          - condition: template
            value_template: "{{ climate_is_cooling }}"
        sequence:
          - service: climate.set_temperature
            target:
              entity_id: !input climate_entity
            data:
              temperature: !input ac_set_temperature

          - service: climate.set_fan_mode
            target:
              entity_id: !input climate_entity
            data:
              fan_mode: "{{ active_fan_mode }}"
